generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id      Int     @id @default(autoincrement())
  name    String
  entries Entry[]
}

model Entry {
  id           Int        @id @default(autoincrement())
  foodName     String
  category     String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  starred      Boolean    @default(false)
  flag         String?
  manualRank   Int?
  tryAgain     Boolean    @default(false)
  neverAgain   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      Review[]
}

model Review {
  id            Int       @id @default(autoincrement())
  entryId       Int
  entry         Entry     @relation(fields: [entryId], references: [id])
  date          DateTime?
  notes         String?
  rating1       Float?
  rating2       Float?
  rating3       Float?
  overallRating Float?
  uncertainRating Boolean   @default(false)
  price         Float?
  createdAt     DateTime  @default(now())
}
